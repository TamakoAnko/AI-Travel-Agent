DASHSCOPE_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434

# ===== Storage =====
DATABASE_PATH=data/app.db
CHECKPOINT_PATH=data/checkpoints.db
KNOWLEDGE_DIR=data/knowledge

# ===== Server =====
HOST=0.0.0.0
PORT=8000
APP_SECRET=change-me-in-production
