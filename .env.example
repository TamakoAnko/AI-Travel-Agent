# ===== LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPERVISOR_MODEL=deepseek-chat
SUB_AGENT_MODEL=deepseek-chat

# ===== Tools =====
TAVILY_API_KEY=
BAIDU_MAP_API_KEY=

# ===== RAG embeddings =====
# auto: 有 DASHSCOPE_API_KEY 用 DashScope，否则用离线 hash（仅演示）
