# ===== LLM =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
SUPERVISOR_MODEL=deepseek-chat
SUB_AGENT_MODEL=deepseek-chat

# ===== Tools =====
TAVILY_API_KEY=
BAIDU_MAP_API_KEY=

# ===== RAG =====
# sqlite（零依赖兜底）| milvus（LlamaIndex + Milvus）
RAG_BACKEND=sqlite
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=travel_kb

# ===== RAG embeddings =====
# auto: 有 DASHSCOPE_API_KEY 用 DashScope，否则用离线 hash（仅演示）
# dashscope | ollama | hash
EMBED_PROVIDER=auto
DASHSCOPE_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434

# ===== Redis: OTP / token / short-term memory =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 短期记忆达到上限后压缩旧对话，只保留最近 N 条
SHORT_TERM_MAX_MESSAGES=12
SHORT_TERM_KEEP_MESSAGES=6
SHORT_TERM_TTL=604800
SHORT_TERM_SUMMARY_CHARS=1200

# ===== SQLite =====
DATABASE_PATH=data/app.db
CHECKPOINT_PATH=data/checkpoints.db
KNOWLEDGE_DIR=data/knowledge

# ===== LangSmith (optional) =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-travel-agent

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Frontend map (optional) =====
VITE_BAIDU_MAP_AK=
